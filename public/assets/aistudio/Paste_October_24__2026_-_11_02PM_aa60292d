  <!-- JAVASCRIPT: SWIPE MECHANISM & INTERACTIVITY -->
  <script>
    // Universal Swipe-to-Action Manager (Touch & Mouse Support)
    document.querySelectorAll('.swipe-track').forEach(track => {
      const handle = track.querySelector('.swipe-handle');
      const progress = track.querySelector('.swipe-progress');
      const actionName = track.getAttribute('data-action');

      let isDragging = false;
      let startX = 0;
      let currentX = 0;
      let maxDrag = 0;

      function updateBounds() {
        const trackWidth = track.clientWidth;
        const handleWidth = handle.clientWidth;
        maxDrag = trackWidth - handleWidth - 12; // 12px padding buffer
      }

      function onStart(e) {
        updateBounds();
        isDragging = true;
        startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        handle.style.transition = 'none';
        progress.style.transition = 'none';
      }

      function onMove(e) {
        if (!isDragging) return;
        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        
        // In RTL: swipe from right to left means delta is negative (startX - clientX)
        const delta = startX - clientX;
        currentX = Math.max(0, Math.min(delta, maxDrag));

        handle.style.transform = `translateX(-${currentX}px)`;
        const percentage = (currentX / maxDrag) * 100;
        progress.style.width = `${percentage}%`;

        // If completed 92% of the swipe path, trigger confirmation
        if (currentX >= maxDrag * 0.92) {
          triggerSuccess();
        }
      }

      function onEnd() {
        if (!isDragging) return;
        isDragging = false;
        
        if (currentX < maxDrag * 0.92) {
          // Snap back with smooth physics
          handle.style.transition = 'transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
          progress.style.transition = 'width 0.3s ease';
          handle.style.transform = 'translateX(0px)';
          progress.style.width = '0%';
        }
      }

      function triggerSuccess() {
        isDragging = false;
        // Lock at the end briefly
        handle.style.transform = `translateX(-${maxDrag}px)`;
        progress.style.width = '100%';
        
        // Visual indicator
        track.classList.add('border-brand-cyan', 'shadow-glow-cyan');
        
        // Trigger Toast & Haptic (if supported)
        if (navigator.vibrate) navigator.vibrate([40, 60, 40]);
        showActionNotification(actionName);

        // Reset after 1.8 seconds for repeated play/action
        setTimeout(() => {
          handle.style.transition = 'transform 0.4s ease';
          progress.style.transition = 'width 0.4s ease';
          handle.style.transform = 'translateX(0px)';
          progress.style.width = '0%';
          track.classList.remove('border-brand-cyan', 'shadow-glow-cyan');
        }, 1800);
      }

      // Pointer / Touch Events
      handle.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      handle.addEventListener('touchstart', onStart, { passive: true });
      window.addEventListener('touchmove', onMove, { passive: true });
      window.addEventListener('touchend', onEnd);
