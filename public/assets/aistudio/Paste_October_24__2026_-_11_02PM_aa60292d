    // Toast feedback function
    function showActionNotification(actionTitle) {
      const toast = document.getElementById('actionToast');
      document.getElementById('toastActionTitle').innerText = `${actionTitle} הופעל!`;
      document.getElementById('toastActionSubtitle').innerText = `האינטראקציה נשמרה כנכס`;
      
      toast.classList.remove('-translate-y-24');
