rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Validation helpers
    function isValidTodayTask(data) {
      return data.keys().hasAll(['title', 'completed', 'priorityIndex', 'date', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'completed', 'completedAt', 'priorityIndex', 'estimatedMinutes', 'originInboxId', 'date', 'createdAt']) &&
        (!('userId' in data) || data.userId is string) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.completed is bool &&
        data.priorityIndex is number && data.priorityIndex >= 1 && data.priorityIndex <= 3 &&
        data.date is string && data.date.size() <= 20 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidInboxItem(data) {
      return data.keys().hasAll(['title', 'decomposed', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'note', 'decomposed', 'createdAt', 'microTasks']) &&
        (!('userId' in data) || data.userId is string) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.decomposed is bool &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidMicroTask(data) {
      return data.keys().hasAll(['title', 'estimatedMinutes', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'inboxItemId', 'inboxItemTitle', 'title', 'estimatedMinutes', 'scheduledFor', 'createdAt']) &&
        (!('userId' in data) || data.userId is string) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidBrainstorm(data) {
      return data.keys().hasAll(['title', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'messages', 'createdAt', 'updatedAt']) &&
        (!('userId' in data) || data.userId is string) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // 1. Connection check doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // 2. Core task & workspace collections (allow dev read/write while maintaining schema sanity)
    match /todayTasks/{taskId} {
      allow read: if true;
      allow create: if isValidTodayTask(incoming());
      allow update: if isValidTodayTask(incoming());
      allow delete: if true;
    }

    match /inbox/{inboxId} {
      allow read: if true;
      allow create: if isValidInboxItem(incoming());
      allow update: if isValidInboxItem(incoming());
      allow delete: if true;
    }

    match /microTasks/{microTaskId} {
      allow read: if true;
      allow create: if isValidMicroTask(incoming());
      allow update: if isValidMicroTask(incoming());
      allow delete: if true;
    }

    match /brainstorms/{sessionId} {
      allow read: if true;
      allow create: if isValidBrainstorm(incoming());
      allow update: if isValidBrainstorm(incoming());
      allow delete: if true;
    }

    match /brandDna/{userId} {
      allow read, write: if true;
    }

    // 3. Multi-tenant brand, settings, and dynamic catalog collections
    match /tenants/{tenantId}/{allSubpaths=**} {
      allow read, write: if true;
    }

    match /content_strategies/{strategyId} {
      allow read, write: if true;
    }

    // 4. Dynamic component & CloudStore icon picker collections
    match /icons/{iconId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /cloudstore_icons/{iconId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 5. Global Archetype Presets & Design Collection (KOSUN)
    match /archetype_presets/{presetId} {
      allow read, write: if true;
    }

    match /system_design_presets/{presetId} {
      allow read, write: if true;
    }

    // Default development fallback for any other dynamic collection queries
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
