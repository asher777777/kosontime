rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Validation helpers
    function isValidTodayTask(data) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'priorityIndex', 'date', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'completed', 'completedAt', 'priorityIndex', 'estimatedMinutes', 'originInboxId', 'date', 'createdAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.completed is bool &&
        data.priorityIndex is number && data.priorityIndex >= 1 && data.priorityIndex <= 3 &&
        data.date is string && data.date.size() <= 20 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidInboxItem(data) {
      return data.keys().hasAll(['userId', 'title', 'decomposed', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'note', 'decomposed', 'createdAt', 'microTasks']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.decomposed is bool &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidMicroTask(data) {
      return data.keys().hasAll(['userId', 'title', 'estimatedMinutes', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'inboxItemId', 'inboxItemTitle', 'title', 'estimatedMinutes', 'scheduledFor', 'createdAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidBrainstorm(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'messages', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Collections
    match /todayTasks/{taskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTodayTask(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidTodayTask(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /inbox/{inboxId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(inboxId) && isValidInboxItem(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidInboxItem(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /microTasks/{microTaskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(microTaskId) && isValidMicroTask(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidMicroTask(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /brainstorms/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidBrainstorm(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidBrainstorm(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /brandDna/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
